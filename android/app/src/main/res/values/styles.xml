<resources>
    <style name="Theme.BOYPROVOD" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4C8DFF</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#070A10</item>
    </style>

    <style name="TvNavButton" parent="@android:style/Widget.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/button_tv</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TvPrimaryButton" parent="TvNavButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:layout_width">220dp</item>
    </style>
</resources>